# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database (SQLite for dev; swap provider + URL for Postgres later)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP
OTP_MODE=console
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=3

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS - comma separated list of allowed origins (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=2

# Billing
BILLING_CRON_ENABLED=true
